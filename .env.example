# Backend
APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://trainer:trainer@localhost:5432/trainer?sslmode=disable
TASKS_DIR=./tasks
RUNTIME_DIR=./runtime
RUN_TIMEOUT=20s

# Postgres (docker-compose)
POSTGRES_USER=trainer
POSTGRES_PASSWORD=trainer
POSTGRES_DB=trainer

# Генерация задач через форму в приложении (LLM + PR на GitHub).
# Как в прошлом проекте: ключ ищется по цепочке LLM_API_KEY || DEEPSEEK_API_KEY || OPENAI_API_KEY.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2
# true = не ходить в LLM, вернуть заготовленную задачу (для локальной разработки)
LLM_MOCK=false
GITHUB_TOKEN=
GITHUB_REPO=pozib-hub/interview-trainer-v2
GITHUB_API_BASE=https://api.github.com
PROPOSAL_BASE_BRANCH=main
# true = не создавать PR на GitHub, только сгенерировать и проверить задачу
PROPOSAL_DRY_RUN=false
