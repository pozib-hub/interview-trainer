# Backend
APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://trainer:trainer@localhost:5432/trainer?sslmode=disable
TASKS_DIR=./tasks
QUESTIONS_DIR=./questions
RUNTIME_DIR=./runtime
RUN_TIMEOUT=20s
# IP/CIDR доверенных прокси (через запятую): их X-Real-IP учитывается
# в rate limiting. Для продакшна за nginx укажите адрес прокси/сеть.
TRUSTED_PROXIES=127.0.0.1,::1

# Postgres (docker-compose)
POSTGRES_USER=trainer
# Для продакшна обязательно задайте сильный пароль
POSTGRES_PASSWORD=trainer
POSTGRES_DB=trainer

# Генерация задач через форму в приложении (LLM + PR на GitHub).
# Как в прошлом проекте: ключ ищется по цепочке LLM_API_KEY || DEEPSEEK_API_KEY || OPENAI_API_KEY.
LLM_BASE_URL=https://api.deepseek.com/v1
# Пусто = не слать поле model в запросе, роутер сам выберет модель.
LLM_MODEL=
LLM_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2
# true = не ходить в LLM, вернуть заготовленную задачу (для локальной разработки)
LLM_MOCK=false
GITHUB_TOKEN=
GITHUB_REPO=pozib-hub/interview-trainer-v2
GITHUB_API_BASE=https://api.github.com
PROPOSAL_BASE_BRANCH=main
# true = не создавать PR на GitHub, только сгенерировать и проверить задачу
PROPOSAL_DRY_RUN=false
